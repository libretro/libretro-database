game (
	name "Tombi (Europe)"
	serial "SCES-01330"
	description "Aside from sporting a wacky pink hairdo, Tombi offers a long and brain twisting experience that mixes the traditional 2D side scrolling action/platformer with the elements of a role-playing game. The game starts out simple enough with the evil Koma Pigs stealing Tomba's bracelet, which was given to him by his grandfather. You assume the role of Tombi and begin your adventure. Little do you know that the quest for your bracelet will turn into so much more."
	developer "Whoopee Camp"
	publisher "Sony"
	releaseyear "1998"
	releasemonth "9"
	releaseday "4"
	users "1"
	genre "Platform"
	rom (
		serial "SCES-01330"
		name "Tombi (Europe).cue"
	)
)

