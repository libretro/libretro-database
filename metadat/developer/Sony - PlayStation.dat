game (
	name "Steel Harbinger (Europe)"
	serial "SLES-00373"
	description "It's the year 2069 and the Earth is under attack. Prior to landing, aliens shower the world with thousands of pods, unleashing a force so destructive that all of Earth's armies are powerless to stop it. A legion of teaming metallic tendrils bursts from the pods, infecting nearly every living life form, including humans, animals, plants, and insects, transforming them into mindless killing machines. Dwindling in numbers by the minute, the Earth and all of her citizens are quickly becoming ripe for invasion. During the infestation, Miranda gets partially infected by the tendrils, which turn her body into a powerful weapon but leave her with her basic human instincts intact. With guidance from her scientist father Dr. Bowen, Miranda is the only one powerful enough to save the world."
	developer "Mindscape Inc"
	publisher "Mindscape Inc"
	releaseyear "1996"
	releasemonth "12"
	releaseday "13"
	users "1"
	genre "Action"
	rom (
		serial "SLES-00373"
		name "Steel Harbinger (Europe).cue"
	)
)

game (
	name "Steel Reign (Europe)"
	serial "SCES-01023"
	description "This 3D shooter features eleven different tanks (tracked or hovering) and armored cars, each of them varying in design, ammunition capacity, rate of speed, size, special weapon of choice, and shield and armor strength. You can play either the Arcade or the Quest mode. The Arcade mode lets you switch out vehicles between each level and find bonus tank power-ups, which allow you access to new tanks. In the Quest mode you must stick with the same tank the entire game and carry weapons and tank conditions throughout all the levels. In both modes of play, you can set the degree of control for aiming and targeting, carry two different weapons simultaneously, and use a radar map for revealing enemies, obstacles, etc."
	developer "Chantemar Creations, Inc"
	publisher "Sony Computer Entertainment Europe"
	releaseyear "1998"
	releasemonth "2"
	releaseday "1"
	users "2"
	genre "Action"
