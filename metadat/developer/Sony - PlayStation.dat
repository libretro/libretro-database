	)
)

game (
	name "Ford Truck Mania (Europe)"
	serial "SLES-04109"
	description "Pilot tough Ford Trucks across challenging terrain in this Gotham Games release for PlayStation. Gamers choose from a variety of vehicles, including eight standard Fords and four modified trucks, all with adjustable steering, transmission, tires, suspension, and even color. Races are run in three circuits, Amateur, Semi Pro, and Professional, and a number of options allow players to customize courses and rules to suit their preferences."
	developer "Alpine Studios"
	publisher "Gotham Games"
	releaseyear "2003"
	releasemonth "9"
	releaseday "19"
	users "2"
	genre "Racing"
