game (
	name "Dracula La Risurrezioni (Europe) (Disc 1 of 2)"
	serial "SLES-02761"
	description "Visual Impact Productions handles the PlayStation conversion of this first-person adventure originally released as Dracula Resurrection for the PC and Macintosh. The story begins in London, seven years after Dracula's 'final' defeat, where protagonist Jonathan Harker and his love, Mina, have married and settled down. Mina, still under the master's influence, has gone to Transylvania to fulfill her own yearning for Dracula's bloodlust. Now, Jonathan must prevent her from foolishly unleashing a deadly power on the human race."
	developer "Visual Impact Productions"
	publisher "Microids Canal + Multimedia / France Multimedia"
	releaseyear "2001"
	releasemonth "6"
	releaseday "9"
	users "1"
	genre "Adventure"
