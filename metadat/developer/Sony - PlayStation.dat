game (
	name "Thunderhawk 2 - Firestorm (Europe)"
	serial "SLES-00144"
	description "Your name is General John T. Maclaine and you are the pilot of Firestorm 1, the lead dog in special attack missions to various parts of the world. Your helicopter is extremely powerful and carries the following weapons: 30mm Chain Gun, Firestorm Homing Missile, Rocket Pod, Runaway Cratering System (bombs), the Mk-84 500-Pound Bomb, Cluster Bombs, and the Anti-Ship Missile. These weapons -- plus excellent evasive, and attack maneuvers -- should be enough to help you succeed in attacks on drug runners and terrorists, from Columbia to Iraq."
	developer "Core Design"
	publisher "Core Design Ltd"
	releaseyear "1995"
	releasemonth "12"
	releaseday "10"
	users "1"
	genre "Action"
	rom (
		serial "SLES-00144"
		name "Thunderhawk 2 - Firestorm (Europe).cue"
	)
)

