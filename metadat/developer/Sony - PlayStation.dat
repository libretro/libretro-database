game (
	name "Tekken (Europe)"
	serial "SCES-00005"
	description "Tekken is an arcade fighting game franchise created and developed by Namco. Beginning with the original Tekken arcade game released in 1994, the series has received several sequels, as well as various home conversions and spin-off titles released for consoles. The story in each game in the main series documents the events of the fictional martial arts tournament, The King of Iron Fist Tournament, which is hosted by the Mishima Zaibatsu corporation. The prize is typically control of the company, which then allows the winner to host the following tournament."
	developer "Namco"
	publisher "Namco"
	releaseyear "1995"
	releasemonth "11"
	releaseday "1"
	users "2"
	genre "Fighting"
	rom (
