game (
	name "Fisherman's Bait - A Bass Challenge (Europe)"
	serial "SLES-02085"
	description "Fisherman's Bait is an arcade-style fishing game that has you trying to reel in as many fish as you can within a time limit. Yet the amount of fish isn't all that's important in the game: this is a case where size does matter. That's right, you're aiming to land the largest bass possible in order to earn a spot on the top twenty 'Best Anglers' list. The four game modes are as follows: Beginner (practice mode to get accustomed to the controls), Training (choose one of three lakes and pick a spot to start fishing), Tournament and Versus Play (two-player simultaneous action)."
	developer "KCEO"
	publisher "Konami"
	releaseyear "1999"
	releasemonth "3"
	releaseday "9"
	users "2"
	genre "Sports"
	rom (
		serial "SLES-02085"
		name "Fisherman's Bait - A Bass Challenge (Europe).cue"
	)
)

game (
	name "Fisherman's Bait 2 - Big Ol' Bass (Europe)"
	serial "SLES-02596"
	description "Featuring more than fifteen different kinds of fish, twenty different fishing holes and lots of different lures, Fisherman's Bait 2: Big Ol' Bass is the PlayStation version of the popular Arcade game. Like the Little Max character from Mike Tyson's Punch Out, you are a transparent fisherman. You can go from 'fishin' hole' to 'fishin' hole' according to your preference. All of the spots are different in their variety of species. You also get to pick your own lure, ranging from poppers and worms to jerk bait. All lures produce different results, so choose wisely."
	developer "KCE Nagoya"
	publisher "Konami"
	releaseyear "2000"
	releasemonth "3"
	releaseday "15"
	users "2"
	genre "Sports"
	rom (
		serial "SLES-02596"
		name "Fisherman's Bait 2 - Big Ol' Bass (Europe).cue"
	)
)

game (
	name "Fisherman's Bait 3 (Europe)"
	serial "SLES-03295"
	description "Big Ol' Bass 2 is the third part in the Fisherman's Bait series. The game is known as Fisherman's Bait 3 in Europe and Exciting Bass 3 in Japan. Again there are more than fifteen different types of fish, twenty holes and many different lures. Even more exotic fictional fish make their way in the World Monster Fishing mode. The new Surival mode allows you to partake in a knock-out system. Two player splitscreen is supported against a friend or AI."
	developer "KCE Nagoya"
	publisher "Konami"
	releaseyear "2001"
	releasemonth "3"
	releaseday "9"
	users "2"
	genre "Sports"
	rom (
		serial "SLES-03295"
		name "Fisherman's Bait 3 (Europe).cue"
	)
)

game (
	name "Floating Runner - Quest for the 7 Crystals (Europe)"
	serial "SLES-00453"
	description "The villainous Zaurer has usurped control of the floating lands and at his behest, vile creatures have overrun the seven worlds, terrorizing the inhabitants and generally running amok. As the bounty hunter Lay or the young priestess Cress, players must venture across the lands en route to a final showdown with the evil force behind the chaos. Floating Runner: Quest for the 7 Crystals is a 3D platform adventure consisting of fourteen levels across seven different themed environments, with classic locales ranging from tropical forests to frozen tundra. As in the Mega Man series of titles, players can choose which of the worlds to attempt in whatever order they so desire."
	developer "Kokopeli Digital Studios"
	publisher "THQ"
	releaseyear "1996"
	releasemonth "11"
	releaseday "1"
	users "1"
	genre "Action"
	rom (
		serial "SLES-00453"
		name "Floating Runner - Quest for the 7 Crystals (Europe).cue"
	)
)

game (
	name "Fluid (Europe)"
	serial "SCES-00985"
	description "Fluid (known in Japan as Depth) is a music video game developed by Opus and published by Sony Computer Entertainment for the PlayStation. The game's concept is an interactive sound lab which allows the player to create dance and electronic music. The player uses a dolphin character in 'Cruise Stage' to collect samples for mixing in the 'Groove Editor'."
	developer "Opus Corp"
	publisher "Sony Computer Entertainment"
	releaseyear "1998"
