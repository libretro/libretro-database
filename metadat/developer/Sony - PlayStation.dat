game (
	name "Zero Divide (Europe)"
	serial "SLES-00159"
	description "In Zero Divide, you play as a computer caretaker who must fight off members from the group XTAL and crash the system before the time runs out and critical information is leaked to the world. You go up against ten fighters and two hidden bosses with a variety of moves such as the Hyper Headbutt, Blind Man Slash, the Tomo Vortex Throw, and the Bloody Pack. Watch the action with four camera angles with a rotating 360-degree view. The onscreen diagram keeps you informed of your character's damage, and allows you to plan your strategy for the next attack."
	developer "Zoom Inc"
	publisher "Ocean"
	releaseyear "1996"
	releasemonth "2"
	releaseday "10"
	users "2"
	genre "Fighting"
	rom (
		serial "SLES-00159"
		name "Zero Divide (Europe).cue"
	)
)

