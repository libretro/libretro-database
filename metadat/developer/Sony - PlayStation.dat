game (
	name "Ford Racing (Europe)"
	serial "SLES-03276"
	description "As Ford automobiles have won the NASCAR Winston Cup trophy more often than cars from any other manufacturer, it seems natural to create a game based on this consistent success. Empire Interactive has done just that in Ford Racing. In addition to the classic Taurus or Mustang, players may also choose to race a GT90, an Explorer, an F-Series, or one of several concept cars. In all, twelve different vehicles are available to players in Ford Racing."
	developer "Toolbox Design"
	publisher "Empire Interactive"
	releaseyear "2001"
	releasemonth "2"
	releaseday "16"
	users "2"
