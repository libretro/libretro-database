game (
	name "Z (Europe)"
	serial "SCES-00600"
	description "Z is a eeal-time strategy game with a difference: you fight for control of the sectors, some of which contains manufactories which can gain you additional units. Touch the 'flag' in the sector and it's yours. Capture the sector before the new unit comes out of the manufactory and the new unit is yours. With six different robots (different armaments and armor and speed), multiple vehicles (from jeeps to tanks) the robots can utilize, your ultimate objective is to destroy the opponent's base... And prevent him from doing the same to you..."
	developer "Krisalis Software Ltd / The Bitmap Brothers"
	publisher "Sony Computer Entertainment"
	releaseyear "1997"
	releasemonth "12"
	releaseday "1"
	users "1"
	genre "Strategy"
	rom (
		serial "SCES-00600"
		name "Z (Europe).cue"
	)
)

