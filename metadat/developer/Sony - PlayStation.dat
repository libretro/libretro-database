game (
	name "XI [Sai] (Japan)"
	serial "SCPS-45268"
	description "In THQ's 3D puzzler Devil Dice, players control a cherubic devil that runs across the tops of fallen dice. Players will then flip each die over to match the adjacent dice numbers; for example, if there's a row of four dice with three showing the number six and one showing the number two, the idea is to flip the number two die to have it match the number six. By doing this, you'll cause the entire row to be eliminated and become one step closer to completing the level."
	developer "Shift"
	publisher "Sony"
	releaseyear "1998"
	releasemonth "6"
	releaseday "18"
	users "2"
	genre "Action"
	rom (
		serial "SCPS-45268"
		name "XI [Sai] (Japan).cue"
	)
)

