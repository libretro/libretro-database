game (
	name "Ducati World Racing Challenge (Europe)"
	serial "SLES-02821"
	description "Enter the world of motorcycle racing with Ducati bikes of the past and present. Modes of play allow for players to run quick races over eight courses or the simulation mode called Ducati Life. Simulation mode is where money can be won during races that can then be spent on purchasing a new bike and buying new parts. Both new and used bikes are included that can be purchased and sold. These bikes can also be used in multi-player modes where users can race for ownership of the other player's bike."
	developer "Attention To Detail Limited"
	publisher "Acclaim"
	releaseyear "2001"
	releasemonth "1"
	releaseday "30"
	users "2"
	genre "Racing"
	rom (
		serial "SLES-02821"
		name "Ducati World Racing Challenge (Europe).cue"
	)
)

