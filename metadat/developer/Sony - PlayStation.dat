game (
	name "Speedball 2100 (Europe)"
	serial "SLES-02782"
	description "The first incarnations of Speedball came in the late 1980s with games playable on the home computer systems. The Bitmap Brothers' Speedball 2: Brutal Deluxe was an early release for the Genesis and remains a cult classic today. Speedball 2100 brings the game ahead another decade or so in terms of graphics and sound, but the title remains true to the volatile, fast-paced action and simple control interface that have won the loyalty of many fans. Although Speedball 2100 adds some features over previous versions, it is primarily a port of Speedball 2."
	developer "The Bitmap Brothers"
	publisher "Empire Interactive, Inc"
	releaseyear "2000"
	releasemonth "9"
	releaseday "29"
	users "2"
	genre "Action"
	rom (
		serial "SLES-02782"
		name "Speedball 2100 (Europe).cue"
	)
)

game (
	name "Speedster (Europe)"
	serial "SLES-00575"
	description "Rush Hour is a 3D racing game played from an overhead perspective. Choose from eight international courses and over 15 vehicles, from monster trucks to sports cars, as you compete in one of three game types: time trial, single race, and championship. You'll challenge seven computer-controlled drivers across multiple laps on each course. A road sign icon will periodically appear at the top of the screen to inform you of impending turns, and a replay feature is included to show you what went right (or wrong) during a particular race. Head-to-head racing against a friend is also supported via split-screen display."
	developer "Clockwork Games"
	publisher "Psygnosis"
	releaseyear "1997"
	releasemonth "5"
	releaseday "1"
	users "2"
	genre "Racing"
	rom (
