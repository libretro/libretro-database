game (
	name "Rescue Heroes Molten Menace (Europe)"
	serial "SLES-03724"
	description "Based on characters from Fisher-Price's Rescue Heroes toy line, Molten Menace has players saving the town of Misty Peaks from a volcanic eruption. Each of the six levels features a different character whose primary goal is to rescue stranded victims. Special missions can also be attempted on each level, which may involve saving animals, dousing fires, or clearing a path for trapped people. Each rescue attempt earns players honorary badges at mission's end, but running into hazards on a level can take badges away."
	developer "Runecraft/Asylum Entertainment"
	publisher "Vivendi Universal Games"
	releaseyear "2002"
	releasemonth "5"
	releaseday "24"
	users "1"
	genre "Action"
