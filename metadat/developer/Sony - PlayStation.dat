game (
	name "Street Fighter - The Movie (Europe)"
	serial "SLES-00050"
	description "Street Fighter: The Movie, released in Japan as Street Fighter: Real Battle on Film is a 1995 head-to-head fighting game released for the PlayStation and Sega Saturn. The game is based on the 1994 live-action Street Fighter movie and uses digitized images of the film's cast posing as the characters in the game. While it shares its title with the arcade game Street Fighter: The Movie, the home version is not a port but a similar game developed on the same premise. The home version was developed and published by Capcom in Japan and released in North America and Europe by Acclaim."
	developer "Capcom"
	publisher "Acclaim"
	releaseyear "1995"
	releasemonth "9"
