game (
	name "Cho Aniki - Kyuukyoku Muteki Ginga Saikyou Otoko (Japan)"
	serial "SLPS-00183"
	description "Cho Aniki is a Japanese video game series originally developed by the Masaya and published by NCS Corp. The first game debuted in 1992 for the PC Engine system. The game's sequels and spin-offs later appeared on the Super Famicom, Wonderswan, Sega Saturn, PlayStation, and PlayStation 2. Mainly consisting of side-scrolling shoot 'em up in the vein of Gradius, the Cho Aniki series is best known for its homoerotic overtones, wacky humor and vivid, surreal imagery. Most of the games have never seen release outside Japan, but the series title loosely translates to English as 'Super Big Brothers.'"
	developer "Pre Stage"
	publisher "Nippon Computer System"
	releaseyear "1995"
	releasemonth "12"
	releaseday "29"
	users "2"
	genre "Shooter"
