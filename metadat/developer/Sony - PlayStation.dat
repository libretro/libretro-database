game (
	name "Sonic Wings Special (Japan)"
	serial "SLPS-00307"
	description "Aero Fighters (known as Sonic Wings in Japan) is a vertical-scrolling shoot 'em up ('shmup') arcade game released in 1992 by Video System, ported to the Super Famicom in 1993 and the Super Nintendo in 1994. It spawned two sequels for the Neo-Geo, one for the Arcades (with ports to the PlayStation and Sega Saturn) and one in 3-D for the Nintendo 64. The first sequel was notorious for multiple instances of Engrish, such as 'I never thought I'd be frying over a jungle.'"
	developer "Video System"
	publisher "Media Quest"
	releaseyear "1996"
