	)
)

game (
	name "Street Fighter Alpha 2 (Europe)"
	serial "SLES-00496"
	description "This is the sequel to Street Fighter Alpha. Essentially, the Alpha series, known to some as Street Fighter Zero, takes place before the more popular Street Fighter II. However, many of the characters are the same. In both games are the following characters: Akuma (the boss in Street Fighter 2:CE, and later versions), Chun Li, Dhalsim, Ken, M. Bison, Ryu, Sagat, and Zangief. Some *new* (really older) characters are Adon, Birdie, Charlie, Dan, Gen, Guy, Rolento, Rose, Sakura, and Sodom."
	developer "Capcom"
	publisher "Virgin Interactive"
	releaseyear "1996"
