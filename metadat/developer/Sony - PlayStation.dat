game (
	name "Dragon Ball Z - Ultimate Battle 22 (Europe)"
	serial "SLES-00291"
	description "Dragon Ball Z: Ultimate Battle 22 was originally released for the PlayStation in Japan in 1995 with a European edition following two years later. The 2D fighter finally reaches the United States as the popularity of the animated show on which it's based continues to exhibit robust staying power into the early 2000s. Although the title suggests 22 playable characters, each with an arsenal of unique moves, kicks, spins, slashes, and specialties, an additional five bonus characters can be unlocked with one command, including Master Roshi, Kid Goku, Super Saiyan 3 Goku, Vegeto, and Mr. Hercule Satan."
	developer "Bandai"
	publisher "Bandai"
	releaseyear "1996"
	releasemonth "7"
	releaseday "10"
	users "2"
	genre "Fighting"
	rom (
		serial "SLES-00291"
		name "Dragon Ball Z - Ultimate Battle 22 (Europe).cue"
	)
)

