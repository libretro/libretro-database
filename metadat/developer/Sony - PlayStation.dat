game (
	name "NBA Live 98 (Europe)"
	serial "SLES-00906"
	description "NBA Live '98 brings the furious action of 5 on 5 basketball to the Playstation. A fully licensed product, this title includes all 29 NBA teams from the 1997-'98 season. Featuring user-controlled dunking and passing, a wide variety of moves, and players who actually look like their real-life counterparts. NBA Live '98 supports up to 8 players via Multi-Tap, so you can play with ALL of your friends. When the action gets too intense, you can challenge either the computer or your friends (or both) to the 3-point shoot out contest."
	developer "EA Sports"
	publisher "EA Sports"
	releaseyear "1997"
	releasemonth "10"
	releaseday "15"
	users "8"
	genre "Basketball"
	rom (
