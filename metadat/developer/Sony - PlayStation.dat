game (
	name "Fisherman's Bait - A Bass Challenge (USA)"
	serial "SLUS-00802"
	description "Fisherman's Bait is an arcade-style fishing game that has you trying to reel in as many fish as you can within a time limit. Yet the amount of fish isn't all that's important in the game: this is a case where size does matter. That's right, you're aiming to land the largest bass possible in order to earn a spot on the top twenty 'Best Anglers' list. The four game modes are as follows: Beginner (practice mode to get accustomed to the controls), Training (choose one of three lakes and pick a spot to start fishing), Tournament and Versus Play (two-player simultaneous action)."
	developer "KCEO"
	publisher "Konami"
	releaseyear "1999"
	releasemonth "3"
	releaseday "9"
	users "2"
	genre "Sports"
	rom (
