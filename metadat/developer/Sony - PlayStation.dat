game (
	name "NFL Blitz 2000 (Europe)"
	serial "SLES-02335"
	description "The two teams line up seven per side. It's a typical first and 30 on the initial play from scrimmage. The quarterback snaps the ball only to be pummeled well after the play is over. But there's no flag on the field -- he doesn't even expect one. Why would he when there's no men in zebra-striped shirts (referees) anywhere near the playing field? It's just another day on the gridiron with NFL Blitz 2000."
	developer "Midway Home Entertainment"
	publisher "Midway Home Entertainment"
	releaseyear "2000"
	releasemonth "3"
	releaseday "12"
	users "2"
	genre "Football"
	rom (
