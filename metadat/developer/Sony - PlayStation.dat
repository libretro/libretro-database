game (
	name "Bokujyoukeieiteiki Board Game Umapoly (Japan)"
	serial "SLPM-86403"
	description "Agriculture also called farming or husbandry is the cultivation of animals, plants, fungi, and other life forms for food, fiber, biofuel and other products used to sustain life.[1] Agriculture was the key development in the rise of sedentary human civilization, whereby farming of domesticated species created food surpluses that nurtured the development of civilization. The study of agriculture is known as agricultural science. Agriculture generally speaking refers to human activities, although it is also observed in certain species of ant and termite. The word agriculture is the English adaptation of Latin agricultura, from ager, 'a field', and cultura, 'cultivation' in the strict sense of 'tillage of the soil'. Thus, a literal reading of the word yields 'tillage of fields'."
	developer "KCE Sapporo"
	publisher "Konami"
	releaseyear "1999"
	releasemonth "12"
	releaseday "25"
	users "4"
	genre "Board"
	rom (
		serial "SLPM-86403"
		name "Bokujyoukeieiteiki Board Game Umapoly (Japan).cue"
	)
)

game (
	name "Bomberman (Japan)"
	serial "SLPS-01717"
	description "The gameplay in Bomberman Party Edition represents something of a return to the classic Bomberman style of play. There aren't a lot of extra hoops to jump through, just a lot of things to blow up. The idea is basic; make your way around the board and explode as much stuff as you can. Of course as in the original, lots of power-ups are available to add to the excitement and bring new strategic considerations into the mix. A single-player 'story mode' is available, but the most significant advance in this version of the classic game is that it allows up to five players to compete at once."
	developer "Hudson Soft / Metro"
	publisher "Hudson Soft"
	releaseyear "1998"
	releasemonth "10"
	releaseday "12"
	users "2"
	genre "Action"
	rom (
		serial "SLPS-01717"
		name "Bomberman (Japan).cue"
	)
)

