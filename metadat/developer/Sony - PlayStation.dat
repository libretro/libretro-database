game (
	name "NBA Hoopz (Europe)"
	serial "SLES-03362"
	description "NBA Hoopz takes an extreme approach to the sport of basketball, in terms of both gameplay and presentation. Just as Midway's NFL Blitz caricatures football with exaggerated personality and arcade-style gameplay, NBA Hoopz presents professional basketball with an emphasis on fast action and amazing plays at the expense of strict rules or an overly sophisticated interface. This game is similar in spirit to Acclaim's NBA Jam series, though NBA Hoopz focuses on 3-on-3 action instead of Acclaim's 2-on-2 format."
	developer "Eurocom Developments Ltd"
	publisher "Midway Home Entertainment Inc"
	releaseyear "2001"
	releasemonth "4"
	releaseday "13"
	users "6"
	genre "Basketball"
	rom (
		serial "SLES-03362"
		name "NBA Hoopz (Europe).cue"
	)
)

game (
	name "NBA in the zone (Europe)"
	serial "SLES-00171"
	description "This is the first in the NBA in the Zone games, which is considered a true simulation of the NBA. There are 29 teams to choose from with a full compliment of rosters from the 1996 season and a plethora of offensive and defensive plays to use against their opponents with trick shots like behind-the-back passes, skyhooks, alley-oops, fade-away jumpers and of course the slam dunk."
	developer "Konami"
	publisher "Konami"
	releaseyear "1996"
	releasemonth "4"
