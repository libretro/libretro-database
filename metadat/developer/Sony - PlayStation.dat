)

game (
	name "Cool Boarders 4 (Europe)"
	serial "SCES-02283"
	description "Cool Boarders 4 features 16 real-life professional snowboarders ranging from 13 year-old prodigy Shaun White to veterans such as Noah Salasnek and living-legend Jim Rippey. Players also have the ability to custom-create a rider by selecting a body, choosing brand name attire and gear, and customizing any available board to your liking. Players can choose among 34 boards from Burton, Forum, K2, MLY, M3, Salomon, Ride, Morrow and Santa Cruz."
	developer "Idol Minds"
	publisher "989 Studios"
