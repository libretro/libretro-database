game (
	name "Fear Effect 2 - Retro Helix (Europe) (Disc 1 of 4)"
	serial "SLES-03386"
	description "In the near future, mankind's tinkering with the science of genetics and the developmental process of genome mapping has resulted in the accidental creation of a new disease known as EINDS. This disease, which attacks a cell's DNA and halts mitosis and meiosis (the processes that allow our cells to duplicate), has killed nearly a billion people and no hope of a cure has been discovered."
	developer "Kronos Digital Entertainment, Inc"
	publisher "Eidos Interactive"
	releaseyear "2001"
	releasemonth "1"
	releaseday "22"
	users "1"
	genre "Action"
	rom (
