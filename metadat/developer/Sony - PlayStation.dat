game (
	name "Formula 1 (Europe)"
	serial "SLES-00298"
	description "Formula 1 features the tracks, cars, advertising and excitement from the 1996 Formula 1 season. Murray Walker provides the commentary in his unique style. Players choose from thirty drivers with an abundance of options before even heading out onto the track. Options include weather conditions, arcade or Grand Prix modes, car dynamics, skill level, and number of rounds."
	developer "Bizarre Creations"
	publisher "Psygnosis"
	releaseyear "1996"
	releasemonth "9"
