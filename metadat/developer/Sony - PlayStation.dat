game (
	name "Bomberman Fantasy Race (Japan)"
	serial "SLPS-01525"
	description "Best known for his explosive platforming antics, Bomberman expands his repertoire with a mascot-based racing game entitled Bomberman Fantasy Race. Riding atop rabbit- and kangaroo-like steeds, Bomberman and friends (including the likes of Black Bomberman, Pretty Bomber, Mach Bomber and Mechbomber) scamper around seven different courses with the singular objective of being the first to the finish line. Racers who place in the top three recieve Bomberman coins, which can be put towards the purchase of new tracks, animals, or items. The seven courses encompass all areas of the Bomberman world: Bomber Circuit, Bomber Coaster Lake, Waca Island Beachside, Bakuzan Ski Course, Star Express, Dyna Mountain, and Bomber Castle, many of which are littered with hazards and full of shortcuts."
	developer "Graphic Research Co., Ltd"
	publisher "Hudson Soft"
	releaseyear "1998"
	releasemonth "8"
	releaseday "6"
	users "2"
	genre "Racing"
	rom (
		serial "SLPS-01525"
		name "Bomberman Fantasy Race (Japan).cue"
	)
)

