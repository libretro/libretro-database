game (
	name "Masters Shin Harukanaru Augusta (Japan)"
	serial "SLPS-00373"
	description "The Masters Tournament, also known as The Masters, or The U.S. Masters outside of the United States, is one of the four major championships in professional golf. Scheduled for the first full week of April, it is the first of the majors to be played each year. Unlike the other major championships, the Masters is held each year at the same location, Augusta National Golf Club, a private golf club in the city of Augusta, Georgia, USA. The Masters was started by Clifford Roberts and Bobby Jones, who designed Augusta National with course architect Alister MacKenzie. The tournament is an official money event on the PGA Tour, the PGA European Tour, and the Japan Golf Tour. The field of players is smaller than those of the other major championships because it is an invitational event, entry being controlled by the Augusta National Golf Club."
	developer "T&E Soft"
	publisher "Soft Bank"
	releaseyear "1996"
	releasemonth "7"
	releaseday "12"
	users "4"
	genre "Sports"
	rom (
		serial "SLPS-00373"
