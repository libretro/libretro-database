game (
	name "Schrödinger no Neko - Die Katze von Schrödinger (Japan)"
	serial "SCPS-45075"
	description "Schrödinger's cat is a thought experiment, often described as a paradox, devised by Austrian physicist Erwin Schrödinger in 1935. It illustrates what he saw as the problem of the Copenhagen interpretation of quantum mechanics applied to everyday objects. The thought experiment presents a cat that might be alive or dead, depending on an earlier random event. In the course of developing this experiment, he coined the term Verschränkung—literally, entanglement."
	developer "Dual"
	publisher "Takara"
	releaseyear "1997"
	releasemonth "5"
	releaseday "30"
	users "1"
	genre "Adventure"
	rom (
		serial "SCPS-45075"
		name "Schrödinger no Neko - Die Katze von Schrödinger (Japan).cue"
	)
)

