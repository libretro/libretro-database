game (
	name "Charumera (Japan)"
	serial "SLPS-02415"
	description "The word 'Charumera' reminds Japanese of one of instant ramen brand. It is the representative product of Myojo Foods. But Charumera originally is not a name of instant ramen. Charumera is the name of a kind of flute brought in Japan almost 400 years ago from Portugal. It is cone shaped with double reeds. The name of charumera is believed to have been corrupted from a Portuguese word Charamela meaning 'reed.' Charumera was used by soba yatai (Yonaki-soba) originally around 150 years ago, then after several decades ramen yatai started using it. The melody of 'Do-Re-Mi-Re-Do,Do-Re-Mi-Re-Do-Re' is strongly associated with Ramen yatai in Japanese's mind."
	developer "Victor Interactive Software"
	publisher "Pack-in-Soft (Victor)"
	releaseyear "1999"
	releasemonth "11"
	releaseday "25"
	users "1"
	genre "Simulation"
	rom (
		serial "SLPS-02415"
		name "Charumera (Japan).cue"
	)
)

