game (
	name "Loaded (USA)"
	serial "SLUS-00076"
	description "Set against the backdrop of an inter-galactic penal colony, Loaded sees players, as one of six psychotic inmates, attempting to navigate fifteen enemy-laden levels en route to their ultimate goal; the killing of the sadistic warden -- known as FUB (Fat Ugly Boy) -- of said penal colony. The characters, with names such as Butch, FWANK, Cap N Hands, Mamma, Bounca, and Vox run the gamut from cross-dressing freaks and cyborg pirates to demented clowns and female cyber-criminals. All are rated in a handful of categories; each possessing differing speed, vitality and damage potential attributes. Armed with their character's weapon of choice, up to two players can blast their way through stages populated by fellow inmates, guards, straight-jacket laden mental patients, rats, and more. While objectives are present, the basic formula amounts to scouring each level in search of color-coded keys that will allow you to advance further into the level, while blasting hostiles and collecting ammunition and health power-ups to replenish your reserves. A small on-screen map allows you to find your way through the maze-like stages."
	developer "Gremlin Interactive Ltd"
	publisher "Interplay"
	releaseyear "1995"
	releasemonth "12"
	releaseday "10"
	users "2"
	genre "Action"
	rom (
		serial "SLUS-00076"
		name "Loaded (USA).cue"
	)
)

game (
	name "Lode Runner (USA)"
	serial "SLUS-00557"
	description "Lode Runner for the PlayStation is two games on one disc. First, there is Lode Runner: The Legend Returns, a graphically enhanced remake of the computer classic. Secondly, there is Lode Runner Extra, a sequel of sorts that continues where the former game left off."
	developer "Patra"
	publisher "Natsume"
	releaseyear "1998"
	releasemonth "3"
	releaseday "10"
	users "2"
	genre "Action"
	rom (
		serial "SLUS-00557"
		name "Lode Runner (USA).cue"
	)
)

game (
	name "Looney Tunes - Sheep Raider (USA)"
	serial "SLUS-01369"
	description "Shaggy-haired Sam Sheepdog bids a good morning to his coworker Ralph and punches the clock. Ralph Wolf returns the greeting and punches in as well. The two exchange pleasantries but when the whistle blows, they go straight to work: a full eight-hour day of outrageous cartoon violence as Ralph attempts to steal sheep from Sam's flock and Sam attempts (and seemingly always is able) to thwart Ralph's efforts. First appearing in 1953's Don't Give Up the Sheep, the Warner Bros. duo have starred in another half-dozen cartoon shorts since then, with a unique appeal that seems to span multiple generations."
	developer "Infogrames Lyon"
	publisher "Infogrames"
	releaseyear "2001"
	releasemonth "9"
	releaseday "28"
	users "1"
	genre "Action"
	rom (
		serial "SLUS-01369"
		name "Looney Tunes - Sheep Raider (USA).cue"
	)
)

game (
	name "Looney Tunes Racing (USA)"
	serial "SLUS-01145"
	description "Looney Tunes Racing is a go-kart racing game starring eight characters from Warner Bros.' classic animated franchise. There are 16 tracks to race in four modes of play: Championship, Single Race, Multi-Player, and the ACME Challenge, where artwork, additional characters, and secrets can be unlocked. Power-ups and gags are located throughout every race as the characters attempt to impede each other's progress. All of the characters also have custom karts and speak individual phrases."
	developer "Circus Freak Studios"
	publisher "Infogrames"
	releaseyear "2000"
	releasemonth "11"
	releaseday "13"
	users "2"
	genre "Racing"
	rom (
		serial "SLUS-01145"
		name "Looney Tunes Racing (USA).cue"
	)
)

game (
	name "Lucky Luke (USA)"
	serial "SLUS-00719"
	description "Life in the Wild West is a hectic time; the crazy Dalton Brothers are stealing from innocent townsfolk and robbing each and every bank they can. Fortunately, Lucky Luke, the most cunning and daring lawman in the west, is always there to keep the varmints at bay. He thought he had restored peace to the land by catching the brothers red handed and throwing them in jail, but he was wrong."
	developer "Ocean"
	publisher "Infogrames"
	releaseyear "1998"
	releasemonth "11"
	releaseday "3"
	users "1"
	genre "Action"
	rom (
		serial "SLUS-00719"
		name "Lucky Luke (USA).cue"
	)
)

game (
	name "Lunar - Silver Star Story Complete (USA) (Disc 1 of 3)"
	serial "SLUS-00628"
	description "Lunar: Silver Star Story was originally released on the Sega CD. In its time, it was one of the most cherished role-playing games and reaped in massive critical acclaim from reviewers and players alike. Due to space limitations, Working Designs were forced to restrain some things they wanted in the game. Because it is the company's favorite game, they decided to release Lunar: Silver Star Story Complete on the PlayStation -- an uncut version. It is said that this is the way they had always envisioned it."
	developer "Game Arts / Alfa System"
	publisher "Working Designs"
	releaseyear "1999"
	releasemonth "6"
	releaseday "4"
	users "1"
	genre "Role-playing (RPG)"
	rom (
		serial "SLUS-00628"
		name "Lunar - Silver Star Story Complete (USA) (Disc 1 of 3).cue"
	)
