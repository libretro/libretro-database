game (
	name "FIFA 97 (Europe)"
	serial "SLES-00504"
	description "After an impressive outing with FIFA Soccer, EA is back this season with their continuous soccer lineup, FIFA Soccer 97. Everything has been redone to make sure that gamers get the most for their money. Providing a more thorough gaming experience, EA has made sure that every team, over 4,200 players and 11 International Leagues make their way into the game. Choose from one of four different modes of play and more. For those who had a chance to play last years FIFA Soccer, then the 97 version will serve as a testament of continuous quality. EA has developed FIFA Soccer 97 with the sports gamer in mind."
	developer "High Score Productions"
	publisher "Electronic Arts"
	releaseyear "1996"
	releasemonth "11"
	releaseday "16"
	users "2"
	genre "Sports"
	rom (
		serial "SLES-00504"
		name "FIFA 97 (Europe).cue"
	)
)

