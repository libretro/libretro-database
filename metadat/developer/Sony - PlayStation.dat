game (
	name "Disney's Aladdin in Nasira's Wraak (Europe)"
	serial "SCES-03002"
	description "The mystical and mysterious streets of Agrabah have finally returned to a quiet calm after Jafar's various attacks. The wicked sorcerer turned genie has once again been locked away in his lamp prison, and it seems that Aladdin, Jasmine, and the Sultan will finally have some peace. But sadly, that is not to be. Jafar's twin sister, Nasira, has come to Agrabah to extract her revenge on her brother's tormentors and to free him once and for all. She easily captures the Sultan and Princess Jasmine, and Aladdin only escapes by the skin of his teeth. To break the spell, Aladdin must now capture all of the ancient relics, but there's only one problem. Those relics are the same needed to free Jafar!"
	developer "Argonaut Games"
	publisher "Sony / Disney Interactive"
	releaseyear "2000"
	releasemonth "12"
	releaseday "1"
	users "1"
	genre "Action"
	rom (
		serial "SCES-03002"
		name "Disney's Aladdin in Nasira's Wraak (Europe).cue"
	)
)

