game (
	name "Metal Gear Solid Integral (Japan) (Disc 1 of 3)"
	serial "SCPS-45412"
	description "Released on June 25, 1999 for the PlayStation in Japan, Metal Gear Solid: Integral is an expanded version of the original game based on the North American localization. The original Japanese voices are replaced with the English dub, while offering a choice between Japanese and English captions, and there is an extra disc of virtual reality training missions dubbed the 'VR Disc'. Added to the main game are an alternate sneaking suit outfit for Meryl to complement Snake's tuxedo and the red-colored Ninja, a 'Very Easy' difficulty setting where the player starts their mission with an MP5 sub-machine gun with infinite ammo, new Codec frequencies with staff commentary and hidden music, a first-person view mode, an option for alternate patrol routes for enemies, and a downloadable PocketStation minigame."
	developer "KCE Japan"
	publisher "Konami"
	releaseyear "1999"
	releasemonth "6"
	releaseday "24"
	users "1"
	genre "Action"
	rom (
		serial "SCPS-45412"
		name "Metal Gear Solid Integral (Japan) (Disc 1 of 3).cue"
	)
)

