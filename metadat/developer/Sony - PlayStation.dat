game (
	name "Colony Wars (Europe) (Disc 1 of 2)"
	serial "SLES-00860"
	description "As tends to be the case when humanity's future is extrapolated, two sides are embroiled in an inter-galactic conflict and the outcome will decide the fate of mankind. In this case, it's a civil war between The Earth Empire and the League of Free Worlds. Humanity, having long since drained the planet Earth of its resources, has ventured out into the far reaches of space, colonizing planets and destroying those who would stand in its way. Sick of the cruel treatment at the hands of the despotic Tzar, the colonies revolt. Taking place a few months after the battle of Beney, players assume the role of a generic, faceless, rookie pilot determined to aid the fight for freedom in any way possible."
	developer "Psygnosis"
	publisher "Psygnosis"
	releaseyear "1997"
	releasemonth "11"
	releaseday "7"
	users "1"
	genre "Action"
	rom (
		serial "SLES-00860"
		name "Colony Wars (Europe) (Disc 1 of 2).cue"
	)
)

