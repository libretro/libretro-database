game (
	name "Football Madness (Europe)"
	serial "SLES-04047"
	description "Association football, commonly known as football or soccer, is a sport played between two teams of eleven players with a spherical ball. At the turn of the 21st century, the game was played by over 250 million players in over 200 countries, making it the world's most popular sport. The game is played on a rectangular field of grass or green artificial turf, with a goal in the middle of each of the short ends. The object of the game is to score by driving the ball into the opposing goal."
	developer "Naps Team"
	publisher "Phoenix Games"
	releaseyear "2003"
	releasemonth "3"
	releaseday "1"
	users "2"
	genre "Sports"
	rom (
		serial "SLES-04047"
		name "Football Madness (Europe).cue"
	)
)

game (
	name "Football Manager Campionato 2001 (Europe)"
	serial "SLES-02978"
	description "LMA (League Managers Association) Manager 2001 is the sequel to last year's acclaimed Playstation soccer management title, LMA Manager. Developed by Codemasters, the same British developers behind Colin McRae 2.0 and Jarrett & Labonte Stock Car Racing, LMA 2K1 is a simple take on soccer management that is perfect for casual soccer fans. However, the limitations of the aging PSOne hardware mean that the game doesn't have nearly as much depth as the reigning champ of soccer management games, Championship Manager, and hardcore soccer fans might want to look elsewhere."
	developer "Codemasters"
	publisher "Codemasters"
	releaseyear "2001"
	releasemonth "1"
	releaseday "26"
	users "2"
	genre "Sports"
	rom (
		serial "SLES-02978"
		name "Football Manager Campionato 2001 (Europe).cue"
	)
)

