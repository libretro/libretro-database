game (
	name "Quest for Glory 2: Trial by Fire"
	description "Quest for Glory II: Trial by Fire is a remake of the earlier game game of the same name. It features 256-color VGA graphics (as opposed to the original's 16-color EGA) and an icon-based interface very similar to that of the third game. All the original locations, dialogues, and gameplay elements have been preserved. Though the interface is mouse-based, the player still has the options of choosing topics during conversations by typing them, along with selecting them from a menu."
	releaseyear "1990"
	releasemonth "1"
	releaseday "1"
