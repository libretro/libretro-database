game (
	name "Hi-Res Adventure #1: Mystery House"
	description "Mystery House is a monochrome interactive fiction adventure game that places the player in a Victorian mansion with seven other people. As the player explores the mansion, he discovers that there is a killer murdering each guest one by one. The objective of the game is to figure out who the murderer is before the murderer finds the hero. Players explore and manipulate objects by typing in one or two-word phrases such as 'north' or 'get knife'."
	releaseyear "1980"
	releasemonth "5"
	releaseday "5"
	developer "On-Line Systems"
	genre "Adventure / Interactive Fiction"
	users "1"
	publisher "On-Line Systems"
