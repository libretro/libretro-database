game (
	name "Living Books: The Berenstain Bears in the Dark"
	description "The Berenstain Bears in the Dark is an educational game based on the book of the same name. The plot of the book is that Brother Bear reads Sister Bear a scary story. Then, Sister Bear is afraid of the dark all night. Later that morning, Papa Bear has to show Sister Bear that it is just her imagination. Eventually, Brother Bear is the one afraid of the dark."
	releaseyear "1996"
	releasemonth "1"
	releaseday "1"
	developer "Living Books"
	genre "Adventure / Interactive Book / Education"
	users "1"
	publisher "Brøderbund Software, Inc."
	code "beardark"
