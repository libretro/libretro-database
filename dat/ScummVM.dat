game (
	name "Zork: Grand Inquisitor"
	description "Magic has been banned from the great Underground Empire of Zork. By edict of the Grand Inquisitor Mir Yannick, the Empire has been sealed off and the practice of mystic arts declared punishable by 'Totemization' (a very bad thing). The only way to restore magic to the kingdom is to find three hidden artifacts: The Coconut of Quendor, The Cube of Foundation, and The Skull of Yoruk."
	releaseyear "1997"
	releasemonth "10"
