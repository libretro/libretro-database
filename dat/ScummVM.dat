game (
	name "The Last Express"
	description "Step aboard the 1914 Orient Express in this award-winning mystery adventure from Prince of Persia creator Jordan Mechner. Described as one of the best adventure games of all time, The Last Express is an intrigue-filled adventure set aboard the luxurious Orient Express. All Aboard The Orient Express: In July 1914, on the eve of World War I, as the train departs on its final journey from Paris to Constantinople, you step into the shoes of Robert Cath, an American doctor who's been invited from his best friend Tyler Whitney to join him on the Orient Express. An Unexpected Investigation: Urged to find out why his best friend asked him to boards the train expressly, Robert Cath discovers Tyler, dead in his compartment with a mysterious scroll written in Russian. Explore all the carriages of the train, from your neighbour's compartment to the restaurant to keep up your investigations. Secret Plots To Unveil Into A Graphic Adventure: The Last Express is an intrigue-filled adventure mixing up a complex story with unpredictable plot twists, conspiracy, romance, and murder aboard the luxurious Orient Express. Use this train ride to discuss, hear (or eavesdrop conversations), investigate and discover who has killed your best friend and why. * Unique graphics with a modern style of its own * Multiple endings depending on the choice you'll make (actions got consequences) * An immersive and tensed real-time system"
	releaseyear "1997"
	releasemonth "3"
	releaseday "30"
	developer "Smoking Car Productions"
	genre "Adventure / Point & Click"
	users "1"
	publisher "Brøderbund Software, Inc."
	esrb_rating "T"
	code "lastexpress"
	rom ( name "lastexpress.scummvm" size 12 crc 06d29eb2 md5 2056f8939729d9d10381755c3871bf63 sha1 e6ff64ad7608056ebbf0692cc90952c9fe2255f7 )
)

game (
	name "The Last Express"
	description "Step aboard the 1914 Orient Express in this award-winning mystery adventure from Prince of Persia creator Jordan Mechner. Described as one of the best adventure games of all time, The Last Express is an intrigue-filled adventure set aboard the luxurious Orient Express. All Aboard The Orient Express: In July 1914, on the eve of World War I, as the train departs on its final journey from Paris to Constantinople, you step into the shoes of Robert Cath, an American doctor who's been invited from his best friend Tyler Whitney to join him on the Orient Express. An Unexpected Investigation: Urged to find out why his best friend asked him to boards the train expressly, Robert Cath discovers Tyler, dead in his compartment with a mysterious scroll written in Russian. Explore all the carriages of the train, from your neighbour's compartment to the restaurant to keep up your investigations. Secret Plots To Unveil Into A Graphic Adventure: The Last Express is an intrigue-filled adventure mixing up a complex story with unpredictable plot twists, conspiracy, romance, and murder aboard the luxurious Orient Express. Use this train ride to discuss, hear (or eavesdrop conversations), investigate and discover who has killed your best friend and why. * Unique graphics with a modern style of its own * Multiple endings depending on the choice you'll make (actions got consequences) * An immersive and tensed real-time system"
	releaseyear "1997"
	releasemonth "3"
	releaseday "30"
	developer "Smoking Car Productions"
	genre "Adventure / Point & Click"
	users "1"
	publisher "Brøderbund Software, Inc."
