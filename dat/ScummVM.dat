game (
	name "Maniac Mansion"
	description "The Edison mansion has always been a creepy old house on the edge of town. There have been rumors of strange experiments going on and of odd creatures living amongst the Edison family. There is even a story that a meteorite once crashed near the home nearly 20 years ago. More immediately, a girl named Sandy has gone missing from the local highschool and her boyfriend Dave swears that he saw Dr. Fred abducting her. Dave knows that he cannot do it alone and will need help from two other students if he has any hope of infiltrating the mansion and rescuing Sandy."
	releaseyear "1987"
	developer "LucasArts Entertainment Company, LLC"
	publisher "LucasArts Entertainment Company, LLC"
	franchise "Maniac Mansion"
	genre "Adventure / Point & Click"
	users "1"
	code "maniac"
