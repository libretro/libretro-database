game (
	name "Carol Reed 12: Profound Red"
	description "Profound Red is the twelfth game in the Carol Reed series. In the title Carol is contacted by her friend Stina. The hotel she works at received a suicide note through a text message from a woman called Louise Elliot, but no one knows the connection to the hotel. Carol investigates in Norrkoping to find out who she is and whether there is any suicide involved at all. The game uses its trademark first-person view with photographs of real locations and objects in a fixed-screen slideshow style. There are puzzles to solve with items stored in an inventory near the top of the screen. A journal is used to keep track of objectives. Optionally hints can be activated or all hotspots can be revealed. As a long-running series, some locations are revisited in an updated way as life goes on and there is a cast of new and recurring characters. No knowledge of previous games in required to play."
	releaseyear "2017"
	releasemonth "1"
	releaseday "8"
	developer "MDNA Games"
	genre "Adventure / First Person / Point & Click"
	users "1"
	publisher "MDNA Games"
	code "carolreed12"
	rom ( name "carolreed12.scummvm" size 12 crc ad356a01 md5 72fb3433b78b5188340dff00ccad8455 sha1 e3c0233b2ae7c107c5966d3b12919de53cb56dac )
)

game (
	name "Carol Reed 12: Profound Red"
	description "Profound Red is the twelfth game in the Carol Reed series. In the title Carol is contacted by her friend Stina. The hotel she works at received a suicide note through a text message from a woman called Louise Elliot, but no one knows the connection to the hotel. Carol investigates in Norrkoping to find out who she is and whether there is any suicide involved at all. The game uses its trademark first-person view with photographs of real locations and objects in a fixed-screen slideshow style. There are puzzles to solve with items stored in an inventory near the top of the screen. A journal is used to keep track of objectives. Optionally hints can be activated or all hotspots can be revealed. As a long-running series, some locations are revisited in an updated way as life goes on and there is a cast of new and recurring characters. No knowledge of previous games in required to play."
	releaseyear "2017"
	releasemonth "1"
	releaseday "8"
	developer "MDNA Games"
	genre "Adventure / First Person / Point & Click"
	users "1"
	publisher "MDNA Games"
	code "carolreed12"
	rom ( name "carolreed12.scummvm" size 11 crc 5d883746 md5 5f80eb4e2a430ec324effb9d782bcf69 sha1 425ac6823baa0c368ce63b99c1dd6626adce9bc0 )
)

game (
	name "Carol Reed 13: The Birdwatcher"
	description "The Birdwatcher is the thirteenth game in the Carol Reed series. Set in Sweden in the summer, Carol has been down with the flu. She is contacted by Immodia, a character from a previous game Profound Red, because her future husband Henrik, a recent widower, has disappeared. She wants Carol to help her track him down. The game uses its trademark first-person view with photographs of real locations and objects in a fixed-screen slideshow style. There are puzzles to solve with items stored in an inventory near the top of the screen. A journal is used to keep track of objectives."
	releaseyear "2018"
	releasemonth "1"
	releaseday "3"
	developer "MDNA Games"
	genre "Adventure / First Person / Point & Click"
	users "1"
