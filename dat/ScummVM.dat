game (
	name "Fun Seeker's Guide to Eastern Madera County"
	description "The Fun Seeker's Guide was written and programmed by Doug Oldfield, a programmer who's name you might have noticed in the credits of Space Quests 3 and 4 - as well as several other Sierra products. Generally a very busy guy, he apparently had a little too much time on his hands a few years back and was inspired to create this little gem which offers a unique perspective on one of the more interesting attractions (if not THE most interesting) in our humble Sierra foothill community. Anyone who has ever visited us here in Oakhurst or has driven along highway 41 on their way to Yosemite will probably recognize the subject of this program."
	releaseyear "1989"
	releasemonth "1"
	releaseday "1"
	developer "Sierra On-Line, Inc."
	genre "Demo"
