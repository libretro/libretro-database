game (
	name "Life Flashes By"
	description "Life Flashes By is a 2D point-and-click adventure game where the player takes on the role of Charlotte Barclay, a middle-aged writer going through a near-death experience. Accompanied by a wisecracking fairy-like spirit guide named Trevin, she finds herself exploring short vignettes from defining moments in her past, and seeing how her life might have turned out if she'd made different decisions instead. Unlike most staples of the genre, Life Flashes By is entirely without puzzles, focusing instead on interactive menu-driven conversations and non-linear story exploration. Surrealist cartoon artwork and a whimsical soundtrack provide an atmospheric background to the mix of dry comedy and melancholy drama that the story as a whole conveys."
	releaseyear "2010"
	releasemonth "11"
	releaseday "23"
	developer "Deirdra Kiai Productions"
	genre "Adventure / Point & Click"
	users "1"
	publisher "Deirdra Kiai Productions"
	code "life"
	rom ( name "life.scummvm" size 5 crc 68cb14b6 md5 5b019d44541d974a2cbf3299c8279c10 sha1 c9992412716fe007f38462d814d2ddda981933f9 )
)

