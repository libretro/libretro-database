game (
	name "Hi-Res Adventure #4: Ulysses and the Golden Fleece"
	description "Ulysses and the Golden Fleece is an adventure game where you play the part of Ulysses in ancient Greece. The king has given you the task of finding the golden fleece, a legendary treasure which is protected by the gods. You begin your quest in a small town, and will need to travel to several far away lands to find the fleece. Many characters from ancient mythology will be encountered along the way, including King Neptune, the Sirens, Cyclops, and others. You need to find a way past them as well as the many obstacles on sea and land if you are to be successful."
	releaseyear "1981"
	releasemonth "1"
	releaseday "1"
	developer "On-Line Systems"
	genre "Adventure / Interactive Fiction"
	users "1"
	publisher "On-Line Systems"
