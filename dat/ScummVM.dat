game (
	name "Leisure Suit Larry: Love for Sail!"
	description "Will Larry hit bottom or dock his little dinghy? Drop a world-class lounge lizard onto a cruise ship filled with gorgeous women and what do you get? Side-splitting slapstick? A bawdy bevy of beauties? The Lust Boat? Actually, youve got it right in your hands! Its Leisure Suit Larry in Love for Sail! This trip, Al Lowe sets his wacky sense of humor to full speed ahead in the latest, greatest chapter in the hapless, hopeless life of softwares best-loved loser. Its nautical, but nice!"
	releaseyear "1996"
	releasemonth "10"
	releaseday "31"
	developer "Sierra On-Line, Inc."
	genre "Adventure / Point & Click"
	users "1"
	publisher "Sierra On-Line, Inc."
	esrb_rating "M"
