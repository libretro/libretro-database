game (
	name "Let's Explore the Airport with Buzzy"
	description "The Airport allows kids 3-8 (or any age) to explore a modern airport, with their guide Buzzy The Knowledge Bug. Kids can visit over 40 locations, from hangars, to control towers, to cockpits. Items in each location can be clicked on for either amusing animations, or to ask What is This? which will take them directly to the encyclopedia page describing that item."
	releaseyear "1995"
	releasemonth "3"
	releaseday "3"
	developer "Humongous Entertainment, Inc."
	publisher "Humongous Entertainment, Inc."
	franchise "Junior Field Trips"
	genre "Education"
	users "1"
	esrb_rating "E"
