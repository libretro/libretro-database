game (
	name "Corrosion: Cold Winter Waiting"
	description "Sheriff Alex Truman is driving his patrol car when a man suddenly walks out in front of him on the road. The resulting collision puts the man in the hospital, his identity unknown. The first lead comes two months later when the man finally speaks, uttering only three words to his doctors: 'Cold Winter Farm'. The Sheriff only knows that the farm is on the outskirts of town, so even though a terrible storm is raging, he decides to check it out. Minutes after entering, a tree falls on the roof and Truman finds himself trapped in the basement. When the worst is over and Alex gets his bearings, he realizes that his only way out is through that once-hidden door, corridor and elevator leading down to who-knows-where. Apprehensive, but throwing caution to the wind, he proceeds. He soon realizes he has stumbled upon a secret bunker of some kind, hidden away from the public eye. What is it, who built it and what was it used for?"
	releaseyear "2012"
	releasemonth "2"
	releaseday "9"
	developer "Viperante Creative Media"
	genre "Adventure / First Person / Point & Click"
	users "1"
	publisher "Tri Synergy, Inc."
	code "corrosion"
	rom ( name "corrosion.scummvm" size 10 crc 96dc72ac md5 118abff5f3449c12a53e9f2f6c56c357 sha1 a80f202d82d75b106e52aced14b7b27418c2c2f3 )
)

