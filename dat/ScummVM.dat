game (
	name "Caitlyn's Destiny"
	description "An evil wizard named Archidamus steals the six Eternal Spheres from King Demetrius' realm, the land of Valeria. Archidamus had been banned by Demetrius for killing his only daughter, and now is back, not for good, but for evil. The king calls for his only wizard left, Artemedoris, who claims that his powers have weakened. And his old friend and colleague Cicero is dead. Yet, there is hope: Caitlyn, Cicero's granddaughter, an 18-year-old girl is the one to save Valeria. As she has no idea of her magical powers, Artemedoris tells her about her grandfather who left her a spellbook. She has to find and activate it and after some more preparations she starts her quest to search for the six stolen Eternal Spheres."
	releaseyear "2004"
	releasemonth "12"
	releaseday "23"
	developer "Corby LaCroix"
	genre "Adventure / Point & Click"
	users "1"
	publisher "Corby LaCroix"
	code "caitlyn"
	rom ( name "caitlyn.scummvm" size 8 crc 045593ae md5 2e78989e0fcdd92933ad41b78bff6560 sha1 43ad9697ecdc7e2fd01d6dad2d38cec02bfb34cd )
)

