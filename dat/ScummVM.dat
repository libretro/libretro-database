game (
	name "Mystery Fun House"
	description "Mystery Fun House is the seventh entry in the original Scott Adams adventure series. The events of the game take place at an amusement park. The first puzzle involves figuring out how to get in past the turnstiles. Once inside, the player must solve the mystery of the place, going through a house of mirrors and so forth. Like the others in the series, the game is a text adventure with a rather basic two-word command parser. The Japanese computer versions feature graphics in addition to the text input."
	releaseyear "1980"
	releasemonth "1"
	releaseday "1"
	developer "Scott Adams"
	publisher "Adventure International"
	franchise "Scott Adam's Adventure"
	genre "Adventure / Interactive Fiction"
	users "1"
