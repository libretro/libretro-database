game (
	name "The Sound of One Hand Clapping"
	description "You are Ginseng, a young man carrying nothing. You are walking through a windswept field, full of life, towards the serene temple to the west. There, the aged priestess tells you that Black Dragon has returned to the World Beyond, its folk banished and replaced by dragons. The dragons hold the keys that will restore the hope which was lost. It is your task to deal slyly with the dragons and restore that hope."
	releaseyear "1993"
	releasemonth "1"
	releaseday "1"
	developer "Erica Sadun"
