game (
	name "Moonbase Commander"
	description "Moonbase Commander is a turn-based strategy game where players compete to spread a web-like base across a lunar battlefield while annihilating their opponents. Players can select from four factions each of which has a unique look for it's units and a specifically voiced adviser (although all four have identical capabilities) and compete alone or in teams against other humans (locally or via the net) or the assorted Bots that are included. Competition takes place on a variety of terrain, sometimes barren and empty sometimes green and full of rivers."
	releaseyear "2002"
	releasemonth "8"
	releaseday "13"
	developer "Humongous Entertainment, Inc."
	publisher "Rebellion Developments Ltd."
	genre "Strategy / Turn-based"
