game (
	name "The Better Dead Ratification"
	description "One of the biggest mysteries of the highly unusual and controversial American game The Better Dead Ratification is the existence of a Japanese-language Windows version of it in nature. It's hard to say what made publishers from the Land of the Rising Sun pay attention to this particular Macintosh-exclusive, which is not the most (to put it mildly) popular in their homeland. Perhaps they were attracted by elements of surrealism and a non-standard plot, reminiscent of eastern rather than western projects?"
	releaseyear "1995"
	releasemonth "1"
	releaseday "1"
	developer "Richard M. Coombs"
	genre "Adventure / First Person / Point & Click"
	users "1"
	publisher "NEC Interchannel, Ltd."
	code "betterd"
	rom ( name "betterd.scummvm" size 8 crc 084aee87 md5 98734b44b0c0254548de51808cf278a5 sha1 c3473a6dd530b44706384088a7408ebf336c5516 )
)

