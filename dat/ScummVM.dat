game (
	name "Crazy Nick's Picks: Leisure Suit Larry's Casino"
	description "Crazy Nick's Software Picks: Leisure Suit Larry's Casino is one of the five Nick's Picks budget games by Sierra. The game consists of three casino mini-games: Slot machine, Black Jack and Poker. You start with 100.00 Larry Dollars to gamble with during the games. In the case you loose everything a loan is possible, You play with the hand of Larry and operate the buttons. During the mini-games you get more information about the bets / odds in a text window."
	releaseyear "1992"
	releasemonth "6"
	releaseday "5"
	developer "Sierra On-Line, Inc."
	genre "Cards & Tiles"
	users "1"
	publisher "Sierra On-Line, Inc."
