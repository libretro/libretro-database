game (
	name "Quest for Glory III: Wages of War"
	description "Wages of War is the third game in the Quest for Glory series. It is set in the Africa-like world of Tarna, where the hero travels with paladin Rakeesh, his new Liontaur friend he has met in the previous game. Shortly after his arrival, the hero learns about the conflict between the human Simbani tribe and the seemingly malevolent neighboring Leopardmen. It is now time for our hero to become a skillful diplomat and prevent an upcoming war between the two nations."
	releaseyear "1992"
	releasemonth "8"
	releaseday "1"
	developer "Sierra On-Line, Inc."
