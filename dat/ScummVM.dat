game (
	name "Carol Reed 6: Black Circle"
	description "Black Circle is the sixth Carol Reed game. Like the previous titles in the Carol Reed series, the game is a point and click adventure set in Norrkoping, Sweden. It's created with real photographs with a watercolour effect. Carol is a British girl but she lives in Sweden, where she has taken over a detective agency. In Black Circle, Carol is contacted by her neighbour Oscar, who is a retired doctor. On one of his morning walks he discovers a body, but when he goes home to call the police the body disappears and the police don't believe him. He asks Carol to help him find out what happened. Carol travels around town, finding clues, talking to people and solving puzzles."
	releaseyear "2009"
	releasemonth "2"
	releaseday "17"
	developer "MDNA Games"
	publisher "Big Fish Games, Inc"
	franchise "Carol Reed Mysteries"
	genre "Adventure / First Person / Point & Click"
	users "1"
	code "carolreed6"
