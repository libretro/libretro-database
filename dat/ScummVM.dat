game (
	name "Sam & Max Hit the Road"
	description "Sam and Max - a canine shamus and a hyperkinetic rabbit - are the freelance police: private investigators who receive missions from and are answerable to 'The Commissioner'. Upon the completion of a rescue mission from the clutches of a mad scientist, the duo drives through the opening credits and immediately receives a new assignment: Bruno the Bigfoot is missing from the circus and seems to have kidnapped Trixie, the Giraffe-Neck Girl. Sam and Max are on the case and will follow the mystery all across the United States, even if it takes them to such locations as The World's Largest Ball of Twine and The Mount Rushmore Dinosaur Tarpit."
	releaseyear "1993"
	releasemonth "11"
	releaseday "1"
	developer "LucasArts Entertainment Company, LLC"
	publisher "LucasArts Entertainment Company, LLC"
	genre "Adventure / Point & Click"
	users "1"
	code "samnmax"
