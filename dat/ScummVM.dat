game (
	name "The Dark Eye"
	description "The Dark Eye is an interactive adventure through the works of Edgar Allan Poe featuring the voice of William S. Burroughs and the music of Thomas Dolby Robertson. While experiencing an original Poe-esque adventure, the player is transported into several of Poe's most famous works including The Cask of Amontillado and The Tell-Tale Heart. All of the stories are surrealistically rendered with claymation figures and haunting music. Burrough's reading of The Masque of the Red Death is not to be missed."
	releaseyear "1995"
	releasemonth "10"
	releaseday "1"
	developer "Inscape"
	genre "Adventure / First Person / Point & Click"
