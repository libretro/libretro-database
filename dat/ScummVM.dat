game (
	name "Myst"
	description "You have just stumbled upon a most intriguing book, a book titled Myst. You have no idea where it came from, who wrote it, or how old it is. Reading through its pages provides you with only a description of an island world. But it's just a book, isn't it? As you reach the end of the book, you lay your hand on a page. Suddenly your own world dissolves into blackness, replaced with the island world the pages described. Now you're here, wherever here is, with no option but to explore."
	releaseyear "1993"
	releasemonth "9"
	releaseday "24"
	developer "Cyan, Inc."
	publisher "Brøderbund Software, Inc."
	franchise "Myst"
	genre "Adventure / First Person / Point & Click / Puzzle"
	users "1"
	code "myst"
