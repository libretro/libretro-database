game (
	name "Crusader: No Regret"
	description "Crusader: No Regret is a direct sequel to Crusader: No Remorse, its events starting 46 hours after those depicted in the previous game. The protagonist of the game, a silencer known as the Captain, manipulates his escape pod into a WEC freighter heading towards the moon. There, WEC has established itself as the sole power, overseeing mining procedures and using the moon as prison for dissidents. The Resistance members are forced to work for WEC, extracting a precious radioactive component, Di-Corellium. The powerful corporation is not happy to see the Captain on the moon, and he has to use all his wits and skills to survive as WEC, led by Chairman Draygan, is trying to hunt him down."
	releaseyear "1996"
	releasemonth "9"
	releaseday "10"
	developer "ORIGIN Systems, Inc."
	publisher "Electronic Arts, Inc."
	franchise "Crusader"
	genre "Action / Shooter"
	users "1"
	esrb_rating "T"
	code "regret"
	rom ( name "regret.scummvm" size 7 crc b11c1ff8 md5 bff1ed5fb56c04dc2b5db903325af35a sha1 f995b85580f517bd88936542e964435bd9dbd493 )
)

