game (
	name "Duckman: The Graphic Adventures of a Private Dick"
	description "Private detective Duckman becomes a celebrity and is about to star in his own TV show. Now, he lives his life with pleasure, abandoning his family, only to be one day removed and replaced by a new Duckman, a more muscular and superhero-like. The Duckman is about to commit suicide, being rejected by his family, however, his friend, Cornfed, asks him to return his place under the sun and take down the new Duckman. After a series of humorous adventures, Duckman is able to gain access to the studio where the show is filming. There, he confronts his impersonator, who is revealed to be a robot, and is then destroyed. The game culminates with Duckman opposing the one behind the whole impersonator plot, his archenemy, the 'King' Chicken."
	releaseyear "1997"
	releasemonth "5"
	releaseday "1"
	developer "Illusions Gaming Company, The"
	genre "Adventure / Point & Click"
	users "1"
	publisher "Playmates Interactive Entertainment, Inc."
	code "duckman"
	rom ( name "duckman.scummvm" size 8 crc 74a394f2 md5 2a2a2585b11a26b1c6a00d715ea0c1ba sha1 35b0b0b7eaba9449e1160ec51aef8ef94a1d47fe )
)

