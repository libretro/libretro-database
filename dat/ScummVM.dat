game (
	name "Christmas Card 1988"
	description "This is the second electronic Christmas card developed by Sierra On-Line. Originally first distributed among employees and friends, as well as stores as a promotion tool, it was later made available as a download for the Sierra fans also. The card allows to type in a line of text which would then appear as the card plays, particularly aimed at stores, which could promote one of their products or add a personal Christmas message to their customers."
	releaseyear "1988"
	releasemonth "1"
	releaseday "1"
	developer "Sierra On-Line, Inc."
	genre "Demo"
	users "1"
	publisher "Sierra On-Line, Inc."
