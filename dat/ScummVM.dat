game (
	name "Leisure Suit Larry 6: Shape Up or Slip Out!"
	description "Leisure Suit Larry 6: Shape Up or Slip Out! is the fifth entry in the Leisure Suit Larry series of graphical adventure games published by Sierra On-Line. Originally developed for DOS, a remake was produced in CD-ROM format a year after its release. The enhanced version of the game offers revamped graphics in SVGA resolution and voice acting, a first for the series. Both versions use an icon interface similar to other Sierra games of the time, but unlike most Sierra games, the icon bar is visible at all times."
	releaseyear "1993"
	releasemonth "1"
	releaseday "1"
	developer "Sierra On-Line, Inc."
	genre "Adventure / Point & Click"
	users "1"
	publisher "Sierra On-Line, Inc."
	esrb_rating "M"
	code "lsl6"
