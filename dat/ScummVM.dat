game (
	name "Carol Reed 11: Shades Of Black"
	description "Shades of Black is the eleventh game in the Carol Reed series of point-and-click mystery adventure games. Carol has written a book about one of her previous adventures. She has some troubles finding a publisher. However, one of those publishers who has recently rejected her book suddenly sends her a message, telling Carol that he wants to meet her. It turns out the publisher is interested not in Carol's writing skills, but also in her detective abilities. He wants to hire her to find a missing eccentric author. The game uses the familiar presentation of static photographs for exploration and conversations as well as interactive puzzle elements."
	releaseyear "2015"
	releasemonth "9"
	releaseday "9"
	developer "MDNA Games"
	genre "Adventure / First Person / Point & Click"
	users "1"
	publisher "MDNA Games"
