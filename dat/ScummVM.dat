game (
	name "Gobliiins"
	description "Gobliiins is an adventure game where the player controls a team of three goblins: Oups, Ignatius and Asgard (Hooter, Dwayne, and BoBo in the US release) to find four magic components. A voodoo doll has turned their king Angoulafre mad and by collecting the components they can track down Niak the Wizard, the only one who can put things right. The player needs to solve various puzzles by combining the different skills of the three goblins. Its possible switch between them and control them separately. Most of the puzzles are based on coordinated actions. One can cast powerful but erratic spells, another can collect and use objects, and the last can hit things. Action icons are activated at the bottom of the screen. The game takes in 22 landscapes, each of which has puzzles which must be cleared. The characters have limited energy, which can be sapped by traps."
	releaseyear "1991"
	releasemonth "9"
	releaseday "11"
	developer "Coktel Vision"
	genre "Adventure / Point & Click"
	users "1"
	publisher "Sierra On-Line, Inc."
	code "gob1"
	rom ( name "gob1.scummvm" size 5 crc e3ae4af7 md5 8441d43dee794f836440d3d50eee5214 sha1 9e5f108ca2e1e7609b384aa85a80fec6af0210c6 )
)

