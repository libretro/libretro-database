game (
	name "Indiana Jones and the Fate of Atlantis"
	description "Indiana Jones is back! The great archaeologist and adventurer has to solve a grand mystery once again, aided by his trusty whip, his sharp wit, and his courage. A man who calls himself Mr. Smith is interested in a certain ancient statue. When the unsuspecting Indy hands it over to the client, he finds out that Mr. Smith is in fact a colonel in the Nazi army! Why was he so interested in that statue? A young woman who had once worked together with Indy, the pretty red-haired (and a bit troublesome) Sophia, tells him the whole thing must have a connection with the legendary lost continent Atlantis. Gathering clues from all over the world, Indy and Sophia embark on a grand journey across the globe."
	releaseyear "1992"
	releasemonth "6"
	releaseday "15"
	developer "LucasArts Entertainment Company, LLC"
	genre "Adventure / Point & Click"
	users "1"
	publisher "LucasArts Entertainment Company, LLC"
	code "atlantis"
