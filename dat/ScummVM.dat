game (
	name "Reversion: Chapter 1 - The Escape"
	description "The Escape is the first episode in the Reversion 2D point-and-click adventure game series. The game start in Buenos Aires, Argentina, in 2035. The protagonist Christian Milstein wakes up in Garrahan Hospital with no recollection of what happened the 20 years before. A lot has changed however as the city now looks desolate after years of war and is under control of a military organization. In this chapter he needs to find a way to escape the hospital. Along with the way he meets and teams up with Victoria Tesla, a girl also held there."
	releaseyear "2012"
	releasemonth "6"
	releaseday "7"
	developer "3f interactive"
	genre "Adventure / Point & Click"
	users "1"
	publisher "3f interactive"
	code "castleescapech1"
	rom ( name "castleescapech1.scummvm" size 16 crc 79057e5c md5 3850acf93c8da9960aa04f08349bfd4d sha1 085a167cbb2086deeb014d886fa31b2aeca4a896 )
)

