game (
	name "Starship Columbus"
	description "Starship Columbus is a text only text adventure in which the player is a young person aboard the titular space ship. Columbus is humanity's first attempt to reach the stars. It is a generation ship and the player was born there. Due to lack of resources the authority aboard Columbus has decided that upon reaching adulthood every person must pass a test to determine if he/she is suited to be a Columbus citizen. Those who fail are given a choice: either death by laser beam or exile in the abandoned corridors. The player have failed the test and when the game starts he/she stands before the laser but the choice of exile is still a possibility."
	releaseyear "1986"
	releasemonth "1"
	releaseday "1"
	developer "Gary McGath"
	publisher "Freeware"
	genre "Adventure / Interactive Fiction"
	users "1"
