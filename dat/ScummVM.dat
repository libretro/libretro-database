game (
	name "Simon the Sorcerer"
	description "Simon is just an ordinary boy living in modern-day England. One day, his dog Chippy discovers a chest with a book inside, entitled Ye Olde Spellbooke. Without thinking too much, Simon throws the book on the floor; as a result, a portal opens, teleporting the boy and his dog into a fantasy world. Simon is promptly captured by goblins bent on cooking and eating him, but manages to escape. Soon he realizes that he must play the role of an apprentice sorcerer and rescue a benevolent wizard called Calypso from an evil one, aptly named Sordid."
	releaseyear "1993"
	releasemonth "1"
	releaseday "2"
	developer "Adventuresoft Ltd."
	genre "Adventure / Point & Click"
	users "1"
	publisher "Adventure Soft Publishing Ltd."
	code "simon1"
