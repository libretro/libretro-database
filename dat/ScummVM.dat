game (
	name "Backyard Baseball 2001"
	description "As coach, you pick from either the 30 fictitious Backyard Kits, 31 real major league players portrayed as kids, or both. Pick a Backyard Sports team or create your own, or pick from 30 licensed MLB teams (with uniforms and logos). Play a single game, or an entire season (winning pennants and trophies and maybe getting into the Hall of Fame), or even online against other BB2001 players. There's even batting practice, from Tee-ball to Hard difficulties, and a Spectator mode to let two teams duke it out while you watch. And, as with Backyard Sports titles, there are power-ups: pitches like the Big Freeze, Corkscrew, or Elevator."
	releaseyear "2000"
	releasemonth "6"
	releaseday "6"
	developer "Humongous Entertainment, Inc."
	publisher "Humongous Entertainment, Inc."
	franchise "Junior Sports"
	genre "Sports"
	users "1"
	esrb_rating "E"
	code "baseball2001"
