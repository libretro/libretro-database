game (
	name "MYTH: A Guff's Tale"
	description "Myth is a fantastical world of magic and fantasy; a reality bound together by the dreams of its visitors and it needs help...........................your help! Your imagination is the key to every hidden door, the magical sword that will slay any foe! As you journey through the twisted labyrinth of a Grumbling Cave Troll known as Guff, you'll meet outrageous characters and devious puzzles. You're going to need every bit of that imagination of yours if you are to help Guff reclaim his home and halt the oncoming horde of Heroes that tirelessly quest for its hidden treasures."
	releaseyear "2019"
	developer "SOLODESIGN"
	publisher "Freeware"
	genre "Adventure / Point & Click"
	users "1"
	code "mythguff"
