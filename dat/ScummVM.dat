game (
	name "King's Quest III: To Heir is Human"
	description "King Graham and Queen Valanice had two children, Alexander and Rosella, and the kingdom was once peaceful. It wasn't long until Alexander was snatched from his crib and things started to take a turn for the worse. A three-headed dragon threatens the ever-peaceful Daventry, and requires a maiden to be sacrificed every year. Rosella is the chosen one."
	releaseyear "1986"
	releasemonth "11"
	releaseday "1"
